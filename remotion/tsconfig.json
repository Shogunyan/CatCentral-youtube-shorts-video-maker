{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react",
    "resolveJsonModule": true
  }
}
