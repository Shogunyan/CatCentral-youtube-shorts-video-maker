# ============================================================
# CatCentral v2 — environment config
# Copy to .env and fill in your values.
#
# YouTube credentials are shared with the parent project, so
# if you already have a working .env in the root folder you
# don't need to set GOOGLE_* here — v2 inherits them.
# ============================================================

# YouTube OAuth (leave blank to inherit from parent project's .env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Claude AI for dynamic, context-aware title generation.
# Without this, v2 uses the built-in viral template library (still great).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Branding ───────────────────────────────────────────────
V2_WATERMARK_TEXT=@CatCentral

# ── Schedule ───────────────────────────────────────────────
# Comma-separated 24h times. Recommend 12:00 and 18:00 EST for
# maximum audience overlap with US cat-content consumers.
V2_UPLOAD_TIMES=12:00,18:00

# ── Content quality bar ────────────────────────────────────
# Only source clips that already have this many views on YouTube.
# Higher = safer bet, but fewer candidates.
V2_MIN_SOURCE_VIEWS=500000

# ── Video timing ───────────────────────────────────────────
# Ideal clip length in seconds. 15-25s maximises completion rate.
V2_TARGET_DURATION=20
V2_MAX_DURATION=30

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
