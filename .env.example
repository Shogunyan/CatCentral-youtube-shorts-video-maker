# ──────────────────────────────────────────────
# CatCentral YouTube Shorts Maker — Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── YouTube / Google OAuth ──────────────────────
# Get these from Google Cloud Console:
# https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# ── Instagram (optional — for extra source videos) ─
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ── Upload Schedule ────────────────────────────
# Times to upload each day (24h format, comma-separated)
UPLOAD_TIMES=09:00,14:00,19:00

# ── Video Settings ─────────────────────────────
# Number of clips per ranking video
CLIPS_PER_VIDEO=5
# Duration of each clip in seconds (keep total under 58s)
CLIP_DURATION=10
# Watermark text
WATERMARK_TEXT=@CatCentral

# ── Logging ────────────────────────────────────
# ── AI Voiceover ───────────────────────────────────────────────────────────
# Free Microsoft Edge TTS — no API key needed
# Voice options: en-US-GuyNeural (Reddit narrator style, default)
#                en-US-EricNeural, en-US-ChristopherNeural, en-GB-RyanNeural
TTS_ENABLED=true
TTS_VOICE=en-US-GuyNeural

LOG_LEVEL=INFO
